    "react-dom": "^19.2.0"
  },
  "devDependencies": {
    "@msgpack/msgpack": "^3.1.3",
    "@preact/preset-vite": "^2.10.6",
    "@tailwindcss/vite": "^4.3.3",
    "@types/bun": "^1.4.4",
    "@types/react": "^19.2.10",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.1.1",
    "fflate": "^0.8.2",
    "tailwindcss": "^4.3.3",
    "typescript": "^6.0.3",
    "vite": "^8.2.2",
    "vite-plugin-singlefile": "^2.3.3"
  }
