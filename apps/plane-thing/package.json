{
  "name": "plane-thing",
  "private": true,
  "version": "0.2.2",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "dev:device": "vite --mode device",
    "build": "vite build && vite build -c vite.settings.config.ts",
    "typecheck": "tsc --noEmit && tsc --noEmit -p tsconfig.test.json",
    "preview": "vite preview",
